# ---- PayPal (REST API app, Sandbox) ----
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave both empty to run the backend in PayPal *mock mode* (no network calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- LLM (Google Gemini free tier, via its OpenAI-compatible endpoint) ----
# Free key: https://aistudio.google.com/apikey
# If missing, the agent falls back to a conservative 24h cooling verdict.
# Keep this line commented out when you have no key: an empty value makes Spring AI refuse to start.
# LLM_API_KEY=AIza...
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_COMPLETIONS_PATH=/v1beta/openai/chat/completions
LLM_MODEL=gemini-3.5-flash

# ---- Frontend ----
# Same client id as above; empty => frontend shows a "Simulate PayPal approval" button.
VITE_PAYPAL_CLIENT_ID=
VITE_API_BASE=http://localhost:8080
